// Copy this file to config/runtime.jsonc when you want to manage providers by file.
// Keep real secrets in .env.local, .env.production, or shell environment variables.
// The API also auto-generates config/runtime.jsonc on first start from *_API_KEY env vars.
{
  "$schema_version": 1,
  // Agent LLM calls use the Responses contract internally. A custom
  // provider="openai" base URL defaults to LiteLLM's Chat bridge for backward
  // compatibility; set params.use_chat_completions_api=false when that relay
  // has a native /responses endpoint. Official OpenAI endpoints use the
  // turn-scoped Responses WebSocket automatically. A compatible custom relay
  // opts in with params.supports_responses_websocket=true.
  "llm_providers": [
    {
      "name": "deepseek-default",
      "provider": "deepseek",
      "model_name": "deepseek-chat",
      "base_url": null,
      "api_key": "${DEEPSEEK_API_KEY}",
      "context_window_tokens": null,
      "max_input_tokens": null,
      "max_output_tokens": 12000,
      // Default true: send a stable project-level prompt_cache_key. Set false
      // to omit that request field entirely.
      "supports_prompt_cache": true,
      "supports_vision": null,
      "tokenizer": null,
      "tier": "balanced",
      "enabled": true,
      "notes": "",
      "params": {}
    }
  ],
  "media_providers": [
    // Every base_url is a versioned/namespaced API Base URL, not a bare host
    // or a complete endpoint. Protocol request paths only contain resources.
    // 每个 base_url 都是带版本或命名空间的 API Base URL，不是裸域名或完整接口；
    // 协议中的 request path 只保存资源路径。
    // Every media provider uses Universal Model Adapter. Runtime config keeps
    // only connection/model settings and an explicit target reference.
    {
      "kind": "image",
      "name": "image-uma-openai-example",
      "base_url": "https://api.openai.com/v1",
      "api_key": "${IMAGE_API_KEY}",
      "model_name": "gpt-image-1",
      "api_format": "universal_adapter",
      "is_active": false,
      "enabled": false,
      "notes": "Example only. Copy and enable after filling a real API key.",
      "params": {
        "uma": {
          "protocol_id": "openai.compatible-images-generations",
          "operation": "image.generate",
          "target_profile_id": "openai.compatible-images-generations:gpt-image-1"
        }
      }
    },
    // Video providers use Universal Model Adapter. Runtime config stores only
    // the connection and target reference; HTTP contracts live under
    // config/universal_model_adapter/protocols/.
    {
      "kind": "video",
      "name": "seedance-example",
      "base_url": "https://ark.cn-beijing.volces.com/api/v3",
      "api_key": "${VIDEO_API_KEY}",
      "model_name": "doubao-seedance-2-0-260128",
      "api_format": "universal_adapter",
      "is_active": false,
      "enabled": false,
      "notes": "Example only. Copy and enable after filling a real API key.",
      "params": {
        "uma": {
          "protocol_id": "volcengine.seedance-video-task",
          "operation": "video.generate",
          "target_profile_id": "volcengine.seedance-video-task:doubao-seedance-2-0-260128"
        }
      }
    },
    // Audio providers use UMA too. Runtime config stores the connection and
    // audio target reference; capabilities/defaults live in audio_targets.
    {
      "kind": "audio",
      "name": "audio-uma-openai-example",
      "base_url": "https://api.openai.com/v1",
      "api_key": "${AUDIO_API_KEY}",
      "model_name": "tts-1",
      "api_format": "universal_adapter",
      "is_active": false,
      "enabled": false,
      "notes": "Example only. Copy and enable after filling a real API key.",
      "params": {
        "uma": {
          "protocol_id": "openai.media",
          "operation": "audio.speech",
          "target_profile_id": "openai.media:tts-1"
        }
      }
    }
  ],
  "model_tier_defaults": {
    "strong": null,
    "balanced": "deepseek-default",
    "small": null
  },
  "model_assignments": {},
  "app_settings": {
    "agent.max_iterations": 200,
    "agent.max_output_tokens": 12000,
    "agent.auto_archive": true,
    "agent.vision_context_max_images": 8,
    "agent.vision_context_max_dimension": 2048,
    "feature_flags": {},
    "kill_switches": {}
  }
}
